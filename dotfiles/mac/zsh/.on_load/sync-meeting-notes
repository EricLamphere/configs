#!/usr/bin/env zsh
set -euo pipefail

# Headless Cursor agent that follows ~/.cursor/skills/sync-meeting-notes
# and ~/.cursor/rules/ops-stack.mdc against the Obsidian vault.

vault="${SYNC_MEETING_NOTES_VAULT:-$HOME/vaults/notes}"
agent_bin="${SYNC_MEETING_NOTES_AGENT:-$HOME/.local/bin/agent}"

if [[ ! -x $agent_bin ]]; then
  print -u2 "sync-meeting-notes: Cursor agent not found at $agent_bin"
  print -u2 "Install it or set SYNC_MEETING_NOTES_AGENT."
  exit 1
fi

if [[ ! -d $vault ]]; then
  print -u2 "sync-meeting-notes: vault not found at $vault"
  exit 1
fi

if [[ $# -gt 0 ]]; then
  user_prompt="$*"
else
  user_prompt="Sync my meeting notes."
fi

prompt="Follow the sync-meeting-notes skill and the ops-stack user rule.

${user_prompt}

Workspace is the Obsidian vault. Never run git. Do not commit or push."

exec "$agent_bin" \
  -p \
  --trust \
  --force \
  --approve-mcps \
  --sandbox disabled \
  --workspace "$vault" \
  -- "$prompt"
