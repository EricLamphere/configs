get_commit_sha() {
  local dir="$PWD"
  local git_dir=""

  while [[ "$dir" != "/" ]]; do
    if [[ -d "$dir/.git" ]]; then
      git_dir="$dir/.git"
      break
    elif [[ -f "$dir/.git" ]]; then
      # handles git worktrees, where .git is a file containing "gitdir: <path>"
      local gitdir_line
      gitdir_line=$(<"$dir/.git")
      git_dir="${gitdir_line#gitdir: }"
      break
    fi
    dir="$(dirname "$dir")"
  done

  if [[ -z "$git_dir" ]]; then
    echo "Error: this directory is not tracked in git" >&2
    unset DBT_COMMIT_SHA
    return 1
  fi

  local head_content
  head_content=$(<"$git_dir/HEAD")

  local sha
  if [[ "$head_content" == ref:* ]]; then
    local ref_path="${head_content#ref: }"
    ref_path="${ref_path// /}"
    if [[ -f "$git_dir/$ref_path" ]]; then
      sha=$(<"$git_dir/$ref_path")
    else
      sha=$(grep "refs/heads/${ref_path#refs/heads/}" "$git_dir/packed-refs" | awk '{print $1}')
    fi
  else
    sha="$head_content"
  fi

  # export DBT_COMMIT_SHA="$sha"
  echo "$sha"
}
