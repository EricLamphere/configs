export_env() {
    ENV_FILE=$1

    unamestr=$(uname)
    if [ "$unamestr" = 'Linux' ]; then
        export $(grep -v '^#' $ENV_FILE | xargs -d '\n')
    elif [ "$unamestr" = 'FreeBSD' ] || [ "$unamestr" = 'Darwin' ]; then
        export $(grep -v '^#' $ENV_FILE | xargs -0)
    fi
}


worthit() {
    if [ $# -ne 2 ]; then
        echo "Usage: worthit <cost> <time_in_minutes>"
        return 1
    fi

    cost=$1
    time_min=$2

    if [ -z "$SALARY" ]; then
        echo "Error: SALARY environment variable not set (annual salary in USD)"
        return 1
    fi

    # Assume 2080 work hours per year (full-time)
    hourly=$(echo "scale=2; $SALARY / 2080" | bc -l)
    per_min=$(echo "scale=2; $hourly / 60" | bc -l)
    opp_cost=$(echo "scale=2; $per_min * $time_min" | bc -l)

    echo "Opportunity cost: \$$opp_cost (what you make in ${time_min}m)"

    if (( $(echo "$opp_cost > $cost" | bc -l) )); then
        echo "Worth it!"
    elif (( $(echo "$opp_cost == $cost" | bc -l) )); then
        echo "Neutral (opportunity cost = item cost)."
    else
        echo "Not worth it."
    fi
}




