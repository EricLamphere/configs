#!/bin/zsh


echo "----- Installing Homebrew -----"
/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
(echo; echo 'eval "$(/opt/homebrew/bin/brew shellenv)"') >> ~/.zprofile
eval "$(/opt/homebrew/bin/brew shellenv)"


echo "----- Installing Apps -----"
brew install iterm2 sublime-text google-chrome spotify


echo "----- Installing Coding Tools -----"
brew install visual-studio-code r rstudio gh docker python duckdb

echo "----- Installing herdr -----"
curl -fsSL https://releases.herdr.dev/app/install.sh | sh


echo "----- Installing Utils -----"
brew install mdcat tree ddgr w3m lazygit lazydocker


echo "----- Installing Xcode -----"
# Full Xcode (not just Command Line Tools) is required to build VoiceInk.
# mas installs from the Mac App Store; you must be signed into the App Store.
XCODE_APP_STORE_ID=497799835
brew install mas
if [[ ! -d /Applications/Xcode.app ]]; then
  mas install $XCODE_APP_STORE_ID
fi
sudo xcode-select -s /Applications/Xcode.app/Contents/Developer
sudo xcodebuild -license accept
sudo xcodebuild -runFirstLaunch
xcodebuild -downloadComponent MetalToolchain


echo "----- Building VoiceInk (local dictation, from source) -----"
VOICEINK_DIR=~/Projects/VoiceInk
brew install cmake
mkdir -p ~/Projects
if [[ ! -d $VOICEINK_DIR ]]; then
  git clone https://github.com/Beingpax/VoiceInk.git $VOICEINK_DIR
fi
(cd $VOICEINK_DIR && make local && mv ~/Downloads/VoiceInk.app /Applications/)


echo "----- Installing Micro -----"
brew install micro fzf ripgrep bat


echo "----- Installing OhMyZsh -----"
sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"


echo "----- Installing powerlevel10k -----"
brew install powerlevel10k
echo "source $(brew --prefix)/share/powerlevel10k/powerlevel10k.zsh-theme" >>~/.zshrc


echo "----- Installing git-open -----"
git clone https://github.com/paulirish/git-open.git $ZSH_CUSTOM/plugins/git-poen


echo "----- Authenticating With GitHub -----"
gh auth login


echo "----- Cloning configs Repo & Setting Up Files -----"
mkdir ~/Personal
cd ~/Personal
gh repo clone EricLamphere/configs
cd -
source ~/Personal/configs/setup/setup_mac.sh
